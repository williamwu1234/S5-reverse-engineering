 s5monitor.py   | 31 +++++++++++++++++++++++++++----
 www/index.html |  1 +
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/s5monitor.py b/s5monitor.py
index c26943b..c8d9b82 100644
--- a/s5monitor.py
+++ b/s5monitor.py
@@ -1031,15 +1031,23 @@ class Handler(BaseHTTPRequestHandler):
             if s5_content is None:
                 self._json({"error": "s5_content 不可用"}, 503); return
             oid = (q.get("id") or ["0"])[0]
-            # ★ 关键：DLNA 内容树只在**回放模式**下有内容（实测定因）。
-            #   默认自动切到 playmode；?play=0 可关闭（避免打断正在进行的取景）。
-            if (q.get("play") or ["1"])[0] == "1":
+            # ★ DLNA 内容树只在**回放模式**下有内容（实测定因）。
+            #   本进程原为拍摄模式（推流用），所以这里临时切回放，
+            #   **办完必须切回 rec** —— 否则实时取景会一直卡（曾因此误判为"卡顿复发"）。
+            auto = (q.get("play") or ["1"])[0] == "1"
+            restore = (q.get("restore") or ["1"])[0] == "1"
+            if auto:
                 try:
                     s5_content.cam_cgi(self.cam.host, "camcmd", value="playmode")
                     time.sleep(3.0)
                 except Exception:
                     pass
-            st, body = s5_content.browse(self.cam.host, oid)
+            try:
+                st, body = s5_content.browse(self.cam.host, oid)
+            finally:
+                if auto and restore:
+                    # 后台切回拍摄模式，不阻塞本次响应
+                    threading.Thread(target=self._restore_recmode, daemon=True).start()
             items = s5_content.parse_items(body) if body else []
             fault = s5_content.parse_fault(body)
             if st == 200 and items:
@@ -1076,6 +1084,9 @@ class Handler(BaseHTTPRequestHandler):
                 self._json({"error": "缺 res 参数"}, 400); return
             outdir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "downloads")
             dst = os.path.join(outdir, os.path.basename(name))
+            auto = (q.get("play") or ["1"])[0] == "1"
+            if auto and (q.get("restore") or ["1"])[0] == "1":
+                threading.Thread(target=self._restore_recmode, daemon=True).start()
             ok, n = s5_content.download(self.cam.host, res, dst)
             if not ok:
                 self._json({"error": "下载失败"}, 502); return
@@ -1120,6 +1131,18 @@ class Handler(BaseHTTPRequestHandler):
         self.do_GET()
 
     # ---- MJPEG 推送 ----
+    def _restore_recmode(self):
+        """把相机切回拍摄模式 —— 相册用完必须调用，否则实时取景会卡住。
+        延迟 1.5s 再切，给 DLNA/下载留出余量。"""
+        try:
+            time.sleep(1.5)
+            self.cam.camcmd("recmode")
+            time.sleep(2.0)
+            if LUTLIB is not None and getattr(LUTLIB, "enabled", False):
+                pass
+        except Exception:
+            pass
+
     def _mjpeg(self):
         # ?lut=1 时对每一帧套用当前 LUT（实时监看级；单帧约 20–26 ms @640x432）
         use_lut = False
