+const $q = (x) => document.querySelector(x);
+function lutPanel(show){
+  const el = $q('#lutpanel');
+  el.classList.toggle('show', show === undefined ? !el.classList.contains('show') : show);
+}
+async function loadLuts(){
+  try{
+    const r = await (await fetch('/api/luts')).json();
+    if (r.error){ $q('#lutStat').textContent = r.error; return; }
+    const sel = $q('#lutSel'); sel.innerHTML = '';
+    (r.files||[]).forEach(f => {
+      const o = document.createElement('option');
+      o.value = f; o.textContent = f; if (f === r.current) o.selected = true;
+      sel.appendChild(o);
+    });
+    $q('#lutOn').checked = !!r.enabled;
+    $q('#lutStat').textContent = r.enabled
+      ? `已启用 · ${r.current} · N=${r.size} · ${r.last_ms||0} ms/帧`
+      : (r.current ? `已加载 ${r.current}（未启用）` : '未选择');
+  }catch(e){ $q('#lutStat').textContent = '读取失败：'+e; }
+}
+async function setLut(name){
+  const r = await (await fetch('/api/lut?name=' + encodeURIComponent(name))).json();
+  if (r.error){ $q('#lutStat').textContent = r.error; return; }
+  $q('#lutStat').textContent = `已加载 ${r.name} · N=${r.size} · 点/帧 ${r.points}`;
+}
+function streamWithLut(on){
+  const base = '/stream?t=' + Date.now() + (on ? '&lut=1' : '');
+  $q('#live').src = base;
+  S.streaming = true;
+  $q('#tStream').textContent = '⏸ 停流';
+  toast(on ? '取景已切到「套 LUT」' : '取景已切回原始');
+}
+async function runContentDiag(){
+  const out = $q('#cOut'); out.textContent = '诊断中（约 20 秒）…';
+  try{
+    const r = await (await fetch('/api/content_diag')).json();
+    out.textContent = r.report || JSON.stringify(r, null, 2);
+  }catch(e){ out.textContent = '失败：' + e; }
+}
+async function listContent(){
+  const out = $q('#cOut'), box = $q('#cList');
+  out.textContent = '列举中…'; box.innerHTML = '';
+  try{
+    const r = await (await fetch('/api/gallery?id=0')).json();
+    if (r.error){ out.textContent = '❌ ' + r.error + '\n' + (r.hint||''); return; }
+    out.textContent = `HTTP ${r.http} · ${r.items.length} 项`;
+    r.items.forEach(it => {
+      const d = document.createElement('div'); d.className = 'citem';
+      d.innerHTML = `<span>${it.title || it.id}</span>`;
+      if (it.res){
+        const b = document.createElement('button'); b.textContent = '下载+套LUT';
+        b.onclick = async () => {
+          b.textContent = '下载中…';
+          const rr = await (await fetch('/api/download?bake=1&name=' +
+            encodeURIComponent(it.title || 'file.jpg') + '&res=' + encodeURIComponent(it.res))).json();
+          b.textContent = rr.error ? ('❌ ' + rr.error) : '✅ 已保存';
+        };
+        d.appendChild(b);
+      }
+      box.appendChild(d);
+    });
+  }catch(e){ out.textContent = '失败：' + e; }
+}
+$q('#tLut').onclick = () => { lutPanel(); loadLuts(); };
+$q('#lutClose').onclick = () => lutPanel(false);
+$q('#lutReload').onclick = loadLuts;
+$q('#lutSel').onchange = (e) => setLut(e.target.value);
+$q('#lutOn').onchange = async (e) => {
+  const cur = $q('#lutSel').value;
+  await fetch('/api/lut?name=' + encodeURIComponent(e.target.checked ? cur : 'off'));
+  await loadLuts();
+  if (S.streaming) streamWithLut(e.target.checked);
+};
+$q('#lutToStream').onclick = () => streamWithLut(true);
+$q('#lutToRaw').onclick = () => streamWithLut(false);
+$q('#cDiag').onclick = runContentDiag;
+$q('#cList').onclick = listContent;
+setInterval(() => { if ($q('#lutpanel').classList.contains('show')) loadLuts(); }, 3000);
 </script>
 </body>
 </html>
