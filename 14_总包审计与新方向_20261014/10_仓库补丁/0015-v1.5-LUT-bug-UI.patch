+                    self._building = False
+                    pend = self._pending
+                    self._pending = None
+                if pend:
+                    try:
+                        self.select_async(*pend)
+                    except Exception:
+                        pass
+        threading.Thread(target=work, daemon=True).start()
+        return dict(building=True, name=name, base=base)
